<component>
	<previews>
		<preview style_bg_color="0x345" />
	</previews>
	<styles>
		<style
			name="style_button"
			width="content"
			height="96"
			bg_color="0xEEB111"
			text_font="Roboto_Medium_30"
			pad_left="40"
			pad_right="40"
			radius="8"
			border_width="0"
		/>
		<style name="style_button_pressed" bg_opa="127" />
		<style name="style_button_checked" bg_color="0xffffff" bg_opa="0" border_width="2" text_color="0xfff" />
	</styles>
	<api>
		<prop name="text" type="string" default="Button" />
	</api>
	<view>
		<style name="style_button" />
		<style name="style_button_pressed" selector="pressed" />
		<style name="style_button_checked" selector="checked" />
		<lv_label align="center" text="$text" />
	</view>
</component>
