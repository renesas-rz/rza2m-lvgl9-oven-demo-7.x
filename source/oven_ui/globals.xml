		<data name="spark1" src_path="images/spark1.png" color_format="argb8888" />
		<data name="spark2" src_path="images/spark2.png" color_format="argb8888" />

		<data name="perf_button_image" src_path="images/performance_button.png" color_format="rgb565a8" />
		<data name="close_button_image" src_path="images/close_button.png" color_format="rgb565a8" />

		<data name="whirlpool_logo" src_path="images/whirlpool_logo.png" color_format="rgb565" />
	</images>

	<fonts>
		<!-- Add <bin> , <tiny_ttf>, <freetype> tags here -->

		<bin
			name="Roboto_Regular_15"
			size="15"
			src_path="fonts/Roboto-Regular.ttf"
			as_file="false"
			bpp="8"
			symbols="•"
		/>
		<bin
			name="Roboto_Regular_20"
			size="20"
			src_path="fonts/Roboto-Regular.ttf"
			as_file="false"
			bpp="8"
			symbols="°"
		/>

		<bin name="Roboto_Medium_15" size="15" src_path="fonts/Roboto-Medium.ttf" as_file="false" bpp="8" />

		<bin
			name="Roboto_Medium_30"
			size="30"
			src_path="fonts/Roboto-Medium.ttf"
			as_file="false"
			bpp="8"
			symbols="°"
			range="0x20-0x7F"
		/>
		<bin name="Roboto_Medium_40" size="40" src_path="fonts/Roboto-Medium.ttf" as_file="false" bpp="8" symbols="°" />
		<bin name="Roboto_Medium_50" size="50" src_path="fonts/Roboto-Medium.ttf" as_file="false" bpp="8" symbols="°" />
		<bin
			name="Roboto_Medium_100"
			size="100"
			src_path="fonts/Roboto-Medium.ttf"
			as_file="false"
			range="0x20,0x30-0x39"
			symbols="°:hm "
			bpp="8"
		/>
		<bin
			name="Roboto_Medium_160"
			size="160"
			src_path="fonts/Roboto-Medium.ttf"
			as_file="false"
			range="0x20,0x30-0x39"
			symbols="°:hm "
			bpp="8"
		/>
		<bin name="Roboto_Bold_15" size="15" src_path="fonts/Roboto-Bold.ttf" as_file="false" bpp="8" />
	</fonts>
</globals>
