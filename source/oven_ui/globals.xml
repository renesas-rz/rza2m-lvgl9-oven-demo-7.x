<globals>
	<api>
		<!-- Add <enumdefs> here -->
	</api>

	<consts>
		<!-- Add <px>, <int>, <color> etc here -->
		<int name="screen_change_speed" value="500" />
	</consts>

	<styles>
		<!-- Add <style> tags here -->
		<style name="style_blur" />
	</styles>

	<subjects>
		<!-- Add <int>, <string>, or <float> subjects here -->

		<int name="subject_roller_view" value="0" min_value="0" max_value="1" />
		<int name="subject_meal_view" value="0" min_value="0" max_value="1" />
		<int name="subject_cook_mode_view" value="0" min_value="0" max_value="1" />
		<int name="subject_time_view" value="0" min_value="0" max_value="1" />

		<int name="subject_temperature" value="190" />
		<int name="subject_cook_time" value="160" help="Cooking time in minutes" />
		<string name="subject_cook_time_fmt" value="02h 40m" />

		<int name="subject_timer_trigger" value="0" />
		<int name="subject_timer_stop" value="0" />
		<int name="subject_timer_add" value="0" />
		<int name="subject_timer_bell_view" value="0" />
		<int name="subject_timer_3min_view" value="0" />
		<int name="subject_show_perf_sidebar" value="0" />
		<int name="subject_gpu_enable" value="1" />

		<string name="subject_recipe_prep_time" value="25 minutes" />
		<string name="subject_recipe_cook_time" value="15 minutes" />
		<string name="subject_recipe_serves" value="4 people" />
		<string name="subject_recipe_ability" value="Easy" />
		<string name="subject_recipe_title" value="Baba Ganoush" />
		<string
			name="subject_recipe_description"
			value="A simple ingredient like aubergine becomes something unique with the right combination of herbs and spices that create a carousel of sensations when you taste this simple but intriguing recipe"
		/>
		<string
			name="subject_recipe_ingredients"
			value="Pizza dough - 1 ball (250 g)&#10;Tomato passata - 120 g&#10;Fresh mozzarella - 125 g&#10;Extra-virgin olive oil - 1 tbsp&#10;Fresh basil leaves - handful&#10;Salt - pinch"
		/>
		<string
			name="subject_recipe_steps"
			value="Spread the tomato passata evenly over the rolled-out dough.&#10;Tear the mozzarella into pieces and distribute across the base.&#10;Drizzle with olive oil and sprinkle lightly with salt.&#10;Place the pizza on a baking tray or preheated stone.&#10;Insert into the oven.&#10;Select Bake, set 220°C, and cook for 12 minutes or until the crust is golden.&#10;Remove from the oven and top with fresh basil leaves.&#10;Slice and serve immediately."
		/>
	</subjects>

	<images>
