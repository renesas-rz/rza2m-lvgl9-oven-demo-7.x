		<data name="bottom_heat_icon" src_path="images/icon_bottom_heat.png" color_format="rgb565a8" />
		<data name="conventional_icon" src_path="images/icon_conventional.png" color_format="rgb565a8" />
		<data name="defrost_icon" src_path="images/icon_defrost.png" color_format="rgb565a8" />
		<data name="true_fan_icon" src_path="images/icon_true_fan.png" color_format="rgb565a8" />
		<data name="moist_fan_icon" src_path="images/icon_moist_fan.png" color_format="rgb565a8" />
		<data name="turbo_grill_icon" src_path="images/icon_turbo_grill.png" color_format="rgb565a8" />

		<data name="arrow_icon" src_path="images/icon_arrow.png" color_format="rgb565a8" />
		<data name="saved_icon" src_path="images/icon_saved.png" color_format="rgb565a8" />
		<data name="serving_icon" src_path="images/icon_serving.png" color_format="rgb565a8" />
		<data name="preparation_icon" src_path="images/icon_preparation.png" color_format="rgb565a8" />
		<data name="difficulty_icon" src_path="images/icon_difficulty.png" color_format="rgb565a8" />
		<data name="bell_icon" src_path="images/bell_icon.png" color_format="rgb565a8" />

		<data name="ganoush_bg" src_path="images/bg_ganoush.png" color_format="rgb565" />

		<data name="lava_cake" src_path="images/lava_cake.png" color_format="rgb565" />
		<data name="salmon" src_path="images/salmon.png" color_format="rgb565" />
		<data name="vegetable" src_path="images/vegetable.png" color_format="rgb565" />
		<data name="pizza" src_path="images/pizza.png" color_format="rgb565" />
