<widget>
	<previews>
		<preview width="800" height="500" style_bg_color="0x1f1616" />
	</previews>
	<styles>
		<style name="style_bar_white" bg_color="0xffffff" width="800" height="12" />
		<style name="style_bar_yellow" bg_color="0xeeb111" />
		<style name="style_text_yellow" text_color="0xEEB111" />
		<style
			name="style_ver"
			width="800"
			height="content"
			pad_all="0"
			radius="0"
			bg_opa="0"
			border_width="0"
			layout="flex"
			flex_flow="column"
			pad_row="40"
			flex_cross_place="center"
			text_font="Roboto_Medium_30"
			text_color="0xffffff"
		/>
		<style
			name="style_hor"
			width="content"
			height="content"
			pad_all="0"
			radius="0"
			bg_opa="0"
			border_width="0"
			layout="flex"
			text_color="0xffffff"
			flex_cross_place="center"
			flex_track_place="center"
			pad_column="0"
		/>
	</styles>
	<api>
		<prop
			name="bind_cook_time"
			type="subject"
			help="The subject that holds the cooking time (minutes) of the recipe"
		/>
		<prop
			name="bind_cook_temperature"
			type="subject"
			help="The subject that holds the cooking temperature of the recipe"
		/>
		<prop
			name="bind_recipe_title"
			type="subject"
			help="The subject that holds the cooking temperature of the recipe"
		/>

		<prop name="bind_bell_view" type="subject" help="The subject that toggles visibility of the bell icon" />
		<prop name="bind_3min_view" type="subject" help="The subject that toggles visibility of the +3 min button" />
		<prop
			name="bind_button_stop"
			type="subject"
			help="The subject that is triggered by the stop button. Used to receive click event"
		/>
		<prop
			name="bind_button_add"
			type="subject"
			help="The subject that is triggered by the +3 min button. Used to receive click event"
		/>
		<prop name="bind_trigger" type="subject" help="The subject that triggers the timer. Set to 1 to trigger" />
	</api>
	<view>
		<style name="style_ver" />
		<lv_label name="title_label" text="Loading" />
		<lv_obj>
			<style name="style_hor" />
			<lv_label name="countdown_left" text="00:00" style_text_font="Roboto_Medium_160">
				<style name="style_text_yellow" selector="checked" />
			</lv_label>
			<lv_label name="countdown_right" text="00" style_text_font="Roboto_Medium_160" hidden="true">
				<style name="style_text_yellow" selector="checked" />
			</lv_label>
		</lv_obj>
		<lv_bar name="progress_bar" value="100" checked="true">
			<style name="style_bar_white" />
			<style name="style_bar_white" selector="indicator" />
			<style name="style_bar_yellow" />
			<style name="style_bar_yellow" selector="indicator|checked" />
		</lv_bar>

		<lv_obj style_pad_column="20">
			<style name="style_hor" />
			<wd_icon />
			<lv_label name="temperature_label" text="180°" style_text_font="Roboto_Medium_100" />
		</lv_obj>
	</view>
</widget>
