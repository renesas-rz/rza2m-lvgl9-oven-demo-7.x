<screen>
	<styles>
		<style name="style_options" bg_opa="0" />
		<style
			name="style_row"
			width="content"
			height="content"
			bg_opa="0"
			radius="0"
			pad_all="0"
			pad_right="40"
			pad_left="40"
			border_width="0"
			layout="flex"
			flex_main_place="space_between"
		/>
		<style
			name="style_column"
			width="content"
			height="content"
			pad_all="0"
			pad_row="28"
			bg_opa="0"
			layout="flex"
			flex_flow="column"
			text_font="Roboto_Medium_30"
			text_color="0xFFFFFF"
			radius="0"
			border_width="0"
		/>
		<style
			name="style_roller"
			width="296"
			height="600"
			bg_color="0xEEB111"
			radius="0"
			border_width="0"
			text_color="0xececec"
			text_font="Roboto_Medium_100"
			pad_all="0"
		/>
		<style
			name="style_roller_selected"
			height="112"
			bg_opa="0"
			border_width="8"
			border_color="0xFFFFFF"
			border_side="bottom"
			text_color="0xFFFFFF"
		/>
		<style
			name="style_overlay"
			width="100%"
			height="100%"
			radius="0"
			border_width="0"
			bg_color="0x000000"
			bg_opa="150"
			pad_all="0"
		/>
		<style
			name="style_button_set"
			width="209"
			height="64"
			border_width="0"
			radius="8"
			text_font="Roboto_Medium_30"
			pad_all="0"
			shadow_width="50"
			shadow_spread="50"
			shadow_color="0xEEB111"
		/>
		<style name="style_bar" width="100%" height="8" radius="0" border_width="0" bg_color="0xFFFFFF" pad_all="0" />
		<style name="style_button_click" bg_color="0xf6cb5f" />
	</styles>

	<animations>
		<timeline name="open">
			<animation
				target="recipe_bg_overlay"
				duration="#screen_change_speed"
				prop="opa"
				start="0"
				end="255"
				early_apply="true"
			/>
			<animation
				target="main_row"
				duration="#screen_change_speed"
				prop="opa"
				start="0"
				end="255"
				early_apply="true"
			/>
			<animation
				target="main_row"
				duration="#screen_change_speed"
				prop="translate_y"
				start="-20"
				end="0"
				early_apply="true"
			/>
			<animation
				target="turn_on"
				duration="#screen_change_speed"
				prop="opa"
				start="0"
				end="255"
				early_apply="true"
			/>
			<animation
				target="turn_on"
				duration="#screen_change_speed"
				prop="translate_y"
				start="20"
				end="0"
				early_apply="true"
			/>
		</timeline>

		<timeline name="close">
			<animation
				target="recipe_bg_overlay"
				duration="1000"
				prop="bg_opa"
				start="140"
				end="255"
				early_apply="true"
			/>
			<animation
				target="main_row"
				duration="#screen_change_speed"
				prop="opa"
				start="255"
				end="0"
				early_apply="true"
			/>
			<animation
				target="turn_on"
				duration="#screen_change_speed"
				prop="opa"
				start="255"
				end="0"
				early_apply="true"
			/>
		</timeline>
	</animations>

	<view style_bg_opa="0">
		<play_timeline_event target="self" timeline="open" trigger="screen_loaded" />

		<play_timeline_event target="self" timeline="close" trigger="screen_unload_start" />
		<wd_recipe_bg />

		<button name="turn_on" text="Turn on" x="-40" y="464" align="top_right">
			<bind_flag_if_eq subject="subject_roller_view" flag="hidden" ref_value="1" />
			<bind_flag_if_eq subject="subject_cook_mode_view" flag="hidden" ref_value="1" />
			<bind_flag_if_eq subject="subject_time_view" flag="hidden" ref_value="1" />
			<!-- <subject_set_int_event subject="subject_timer_3min_view" trigger="clicked" value="0" /> -->

			<screen_create_event screen="baking" anim_type="fade_in" delay="1000" duration="0" trigger="clicked" />
			<event_cb trigger="clicked" callback="make_non_clickable_cb" />
		</button>

		<lv_obj width="100%" y="195" name="main_row">
			<style name="style_row" />
			<lv_obj>
				<style name="style_column" />
				<lv_label text="Function" />
				<wd_icon checked="true" />
				<subject_set_int_event subject="subject_cook_mode_view" trigger="clicked" value="1" />
			</lv_obj>
			<lv_obj>
				<style name="style_column" />
				<lv_label text="Temperature" />
				<lv_label
					text="190°"
					bind_text="subject_temperature"
					bind_text-fmt="%d°"
					style_text_font="Roboto_Medium_100"
					style_pad_top="-0"
					style_pad_bottom="-0"
				/>
				<subject_set_int_event subject="subject_roller_view" trigger="clicked" value="1" />
			</lv_obj>
			<lv_obj>
				<style name="style_column" />
				<lv_label text="Timer" />
				<lv_label text="00h 30m" bind_text="subject_cook_time_fmt" style_text_font="Roboto_Medium_100" />
				<lv_label
					text="Oven will turn off when timer ends."
					style_text_font="Roboto_Regular_20"
					style_pad_top="-5"
				/>
				<subject_set_int_event subject="subject_time_view" trigger="clicked" value="1" />
			</lv_obj>
		</lv_obj>

		<lv_obj>
			<style name="style_overlay" />
			<bind_flag_if_eq subject="subject_roller_view" flag="hidden" ref_value="0" />

			<wd_roller x="225" bind_temperature="subject_temperature" bind_button_set="subject_roller_view" />
		</lv_obj>

		<lv_obj>
			<style name="style_overlay" />
			<bind_flag_if_eq subject="subject_cook_mode_view" flag="hidden" ref_value="0" />
			<wd_cook_mode bind_button_set="subject_cook_mode_view" />
		</lv_obj>

		<lv_obj>
			<style name="style_overlay" />
			<bind_flag_if_eq subject="subject_time_view" flag="hidden" ref_value="0" />
			<wd_time_selector align="top_right" bind_time="subject_cook_time" bind_button_set="subject_time_view" />
		</lv_obj>
	</view>
</screen>
